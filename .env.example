# Option 1 (Recommended): Gemini Developer API key from Google AI Studio
# Get an API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model ID (default: gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Option 2 (Alternative): Google Cloud Vertex AI
# Authenticate with `gcloud auth application-default login`, then uncomment:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_IMPERSONATE_SERVICE_ACCOUNT=optional-sa@your-gcp-project-id.iam.gserviceaccount.com

# Optional: 256-bit HMAC signing key for persistent SQLite MemoryStore files
# (If omitted, MemoryStore creates a random 0600 <db>.hmac_key file automatically)
# MEMORY_GUARD_HMAC_KEY=

# Optional: Local folder containing raw PersonaMem-v1 CSV/JSONL files
# (Only needed when regenerating benchmarks/recall_slice.json from raw upstream files)
# PERSONAMEM_V1_DIR=data/personamem_v1
